generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==============================================================================
// 1. ENUMS
// ==============================================================================

enum Role {
  USER
  ADMIN
}

enum PlanType {
  FREE
  PREMIUM
}

enum StorageProvider {
  SUPABASE
  GOOGLE_DRIVE
}

enum MigrationStatus {
  TEMP
  PROCESSING
  COMPLETED
  FAILED
}

enum ToolType {
  MERGE_PDF
  SPLIT_PDF
  COMPRESS_PDF
  PDF_TO_WORD
  PDF_TO_POWERPOINT
  PDF_TO_EXCEL
  WORD_TO_PDF
  POWERPOINT_TO_PDF
  EXCEL_TO_PDF
  EDIT_PDF
  PDF_TO_JPG
  JPG_TO_PDF
  SIGN_PDF
  WATERMARK_PDF
  ROTATE_PDF
  HTML_TO_PDF
  UNLOCK_PDF
  PROTECT_PDF
  ORGANIZE_PDF
  REPAIR_PDF
  PAGE_NUMBERS
}

enum TaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ==============================================================================
// 2. AUTHENTICATION MODELS
// ==============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  role Role     @default(USER)
  plan PlanType @default(FREE)

  usedBytes BigInt @default(0)
  taskCount Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  files    File[]
  tasks    DocumentTask[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==============================================================================
// 3. CORE APPLICATION MODELS
// ==============================================================================

model File {
  id     String  @id @default(cuid())
  userId String?

  originalName String
  fileKey      String  @unique
  mimeType     String
  sizeBytes    BigInt

  storageProvider StorageProvider @default(SUPABASE)
  migrationStatus MigrationStatus @default(TEMP)
  driveFileId     String?
  moveToDriveAt   DateTime        @default(now())

  createdAt DateTime @default(now())
  expiresAt DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  taskInputs  TaskInputFile[]
  taskOutputs TaskOutputFile[]

  @@index([userId])
  @@index([migrationStatus, moveToDriveAt])
  @@index([expiresAt])
  @@map("files")
}

model DocumentTask {
  id           String     @id @default(cuid())
  userId       String?
  toolType     ToolType
  status       TaskStatus @default(PENDING)
  errorMessage String?    @db.Text

  settings Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  inputFiles  TaskInputFile[]
  outputFiles TaskOutputFile[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([toolType, createdAt])
  @@map("document_tasks")
}

model TaskInputFile {
  id     String @id @default(cuid())
  taskId String
  fileId String
  order  Int    @default(0)

  task DocumentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file File         @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([taskId, fileId])
  @@index([taskId])
  @@index([fileId])
  @@map("task_input_files")
}

model TaskOutputFile {
  id     String @id @default(cuid())
  taskId String
  fileId String

  task DocumentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file File         @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([taskId, fileId])
  @@index([taskId])
  @@index([fileId])
  @@map("task_output_files")
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  action    String
  message   String   @db.Text
  meta      Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([action, createdAt])
  @@map("system_logs")
}

// ==============================================================================
// 4. DYNAMIC MENU MODELS (BARU)
// ==============================================================================

model ToolCategory {
  id          String   @id @default(cuid())
  name        String   @unique   // "Konversi ke PDF"
  slug        String   @unique   // "konversi-ke-pdf"
  description String?  @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menus ToolMenu[]

  @@index([order])
  @@index([isActive])
  @@map("tool_categories")
}

model ToolMenu {
  id          String   @id @default(cuid())
  categoryId  String
  title       String              // "WORD ke PDF"
  slug        String   @unique    // "word-ke-pdf"
  description String?  @db.Text   // "Konversi file Word ke PDF"
  href        String              // "/convert-pdf/word-to-pdf"
  icon        String?             // "/image/icons/word.png"
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  // Relasi opsional ke ToolType
  toolType    ToolType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ToolCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, order])
  @@index([isActive])
  @@index([toolType])
  @@map("tool_menus")
}

// ==============================================================================
// 5. SYSTEM SETTINGS
// ==============================================================================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([key])
  @@map("system_settings")
}